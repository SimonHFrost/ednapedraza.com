{
  "name": "ednapedraza-com",
  "compatibility_date": "2026-10-12",
  // Handles the contact form endpoint; files are served without it.
  "main": "worker/index.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Without this, a form posted without JavaScript (a page navigation)
    // would get the 404 page instead of reaching the Worker.
    "run_worker_first": ["/api/*"]
  },
  // Contact form email (worker/index.js). Sends through Cloudflare Email
  // Routing, which must be on for ednapedraza.com with CONTACT_TO verified
  // as a destination address. The binding can't send anywhere else, so to
  // change the address, change it here and in CONTACT_TO (and in previews).
  "send_email": [
    { "name": "CONTACT_EMAIL", "destination_address": "edna.sapi@gmail.com" }
  ],
  "vars": {
    "CONTACT_TO": "edna.sapi@gmail.com",
    "CONTACT_FROM": "formulario@ednapedraza.com"
  },
  // At most 5 messages a minute from one IP.
  "ratelimits": [
    { "name": "CONTACT_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  // Branch previews don't inherit the settings above. Same setup, but test
  // messages are marked so Edna can tell them apart.
  "previews": {
    "send_email": [
      { "name": "CONTACT_EMAIL", "destination_address": "edna.sapi@gmail.com" }
    ],
    "vars": {
      "CONTACT_TO": "edna.sapi@gmail.com",
      "CONTACT_FROM": "formulario@ednapedraza.com",
      "CONTACT_SUBJECT_PREFIX": "[Prueba] "
    },
    "ratelimits": [
      { "name": "CONTACT_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
    ]
  }
}
